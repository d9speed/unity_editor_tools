.d9_ui_root .setup_footer {
    flex-shrink: 0;
    justify-content: flex-end;
    padding: var(--d9_space_m);
    background-color: var(--d9_color_surface);
    border-top-width: 1px;
    border-top-color: var(--d9_color_border);
}
.d9_ui_root .setup_material { flex-grow: 1; min-width: 100px; }
.d9_ui_root #status { margin-top: var(--d9_space_m); margin-bottom: var(--d9_space_m); }
.d9_ui_root #count { margin-bottom: var(--d9_space_m); }
.d9_ui_root #options .d9_description { margin-top: var(--d9_space_s); }
.d9_ui_root #preview .unity-foldout { margin-top: var(--d9_space_s); }
.d9_ui_root #preview .unity-help-box { flex-shrink: 0; }
.d9_ui_root #preview .unity-object-field { margin-top: var(--d9_space_xs); }
.d9_ui_root #preview .d9_description { overflow: hidden; }
.d9_ui_root .setup_card_header { flex-direction: row; align-items: center; }
.d9_ui_root .setup_card_header .setup_material { flex-basis: 0; flex-grow: 1; margin-right: var(--d9_space_s); }
.d9_ui_root .setup_card_header .unity-object-field__object { color: var(--d9_color_text); }
.d9_ui_root .setup_card_header .d9_toggle { flex-shrink: 0; }
.d9_ui_root .setup_card_header .d9_badge { flex-shrink: 0; }
.d9_ui_root #settings .d9_field, .d9_ui_root #options .d9_field {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.d9_ui_root #settings .unity-base-field__label, .d9_ui_root #options .unity-base-field__label {
    width: 150px;
    flex-shrink: 0;
    margin-bottom: 0;
}
.d9_ui_root #settings .unity-base-field__input, .d9_ui_root #options .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
}
